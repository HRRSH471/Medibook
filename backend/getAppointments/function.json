{
  "bindings": [
    {
      "authLevel": "anonymous",
      "type": "httpTrigger",
      "direction": "in",
      "name": "req",
      "methods": [
        "get"
      ]
    },
    {
      "type": "cosmosDB",
      "name": "appointments",
      "databaseName": "MediBook",
      "containerName": "doctors",
      "connection": "COSMOS_CONNECTION_STRING",
      "sqlQuery": "SELECT * FROM c WHERE c.type = 'appointment'",
      "direction": "in"
    },
    {
      "type": "http",
      "name": "res",
      "direction": "out"
    }
  ]
}